# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...        # 공개 키 (브라우저 노출 OK)
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # ⚠️ 서버 전용. 절대 NEXT_PUBLIC 금지

# 관리자 인증 (모두 서버 전용 — NEXT_PUBLIC_ 붙이지 말 것)
ADMIN_PASSWORD=여기에_교사용_비밀번호
SUPERADMIN_PASSWORD=여기에_본사용_비밀번호
# 세션 쿠키 서명용 시크릿. 아래 명령으로 무작위 생성해서 넣으세요:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=여기에_64자_랜덤_문자열
